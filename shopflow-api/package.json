{
  "name": "shopflow-api",
  "version": "1.0.0",
  "private": true,
  "description": "ShopFlow JSON API - hexagonal TypeScript/Node.js service (domain, application, ports, adapters)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:architecture": "vitest run tests/architecture",
    "test:characterization": "vitest run tests/characterization",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
